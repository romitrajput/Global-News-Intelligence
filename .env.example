# QwickSignal pipeline: copy this file to .env and fill in the values you use.
# .env is for LOCAL runs only (python pipeline.py ...). It is never committed (see .gitignore) and
# is never read by anything in the browser. On GitHub Actions these same names are set as repository
# secrets instead (Settings -> Secrets and variables -> Actions) and .env is not used at all.
#
# Nothing here is required to run the pipeline: with no keys set, it fetches Telegram/RSS posts and
# sorts them with the built-in keyword rules ("free mode"). Each key below only turns on the one
# feature named next to it.

# AI story extraction and the daily briefing (pipeline.py fetch / briefing / all).
# Without this, stories are still collected and shown; they are just sorted by keyword rules instead
# of written up by AI, and the daily briefing is skipped.
ANTHROPIC_API_KEY=

# Phase 2.5, video intelligence (pipeline.py videos). Attaches a verified YouTube video to important
# stories. Without this, video discovery is skipped and the news feed works exactly as before -
# no story ever shows a broken or missing video button.
# Create a key at https://console.cloud.google.com/apis/credentials after enabling "YouTube Data API v3"
# for the project. Restrict the key to that one API. Never put this key in app.js, index.html or any
# other file that reaches the browser - it is used only by pipeline.py, on the server / in the Action.
YOUTUBE_API_KEY=

# Optional: posting to X / reading private Telegram channels / a Telegram "new stories" ping.
# Leave blank to skip that source or notification; nothing else is affected.
X_BEARER_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
