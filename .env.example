# QwickSignal pipeline: copy this file to .env and fill in the values you use.
# .env is for LOCAL runs only (python pipeline.py ...). It is never committed (see .gitignore) and
# is never read by anything in the browser. On GitHub Actions the same names are set as repository
# secrets or variables instead (Settings -> Secrets and variables -> Actions) and .env is not used.
#
# Nothing here is required to run the pipeline: with no keys set, it fetches Telegram/RSS posts and
# sorts them with the built-in keyword rules ("free mode"). Each line below only turns on the one
# feature named next to it.

# AI story extraction and the daily briefing (pipeline.py fetch / briefing / all).
# GitHub: add as a repository SECRET.
ANTHROPIC_API_KEY=

# Phase 2.5, video intelligence (pipeline.py videos). Attaches a verified YouTube video to important
# stories. Without this, video discovery is skipped and the news feed works exactly as before.
# Create a key at https://console.cloud.google.com/apis/credentials after enabling "YouTube Data API v3".
# GitHub: add as a repository SECRET.
YOUTUBE_API_KEY=

# Phase 3, sync and Telegram channel proposals (Link Pages tab). Lets saved/dismissed articles and
# followed channels carry over between a person's own devices, and lets the pipeline pick up a
# Telegram channel someone added from the app once it has been approved (see firestore.rules).
#
# One-time setup (about 5 minutes): create a free project at https://console.firebase.google.com,
# add Firestore Database (production mode), paste firestore.rules into Firestore -> Rules -> Publish,
# then Project settings -> General -> Add app -> Web app, and copy "apiKey" and "projectId" below.
# GitHub: add both as repository VARIABLES (not secrets - this config is meant to be public;
# firestore.rules is what actually protects the data).
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# Optional: posting to X / reading private Telegram channels / a Telegram "new stories" ping.
# GitHub: add as repository SECRETS.
X_BEARER_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: the app's public URL, used in the Telegram "new stories" ping.
# GitHub: add as a repository VARIABLE.
APP_URL=
