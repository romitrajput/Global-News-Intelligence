// QwickSignal: Firestore Security Rules
//
// There is no login, so these rules are the only thing standing between "anyone on the
// internet" and this data. Two collections, two different trust models:
//
//   qs_sync/{code}      One record per sync code. Anyone who has the code can read and
//                       write it (that IS the sharing mechanism - see Sync in app.js).
//                       Rules here only stop abuse: wrong shape, oversized lists, or a
//                       client trying to invent a new field.
//
//   qs_channels/{name}  One record per linked Telegram channel. Anyone can create a NEW
//                       one directly as "approved" - there is no review step. The next
//                       pipeline run (fetch_approved_channels() in pipeline.py) picks up
//                       every "approved" doc and starts fetching it into the shared feed
//                       for everyone. This is an intentional tradeoff (instant activation
//                       over manual review) - see the note in index.html's Link Pages
//                       screen. Once created, a channel document is immutable from the
//                       client: nobody can rewrite someone else's entry or flip a channel
//                       back to some other status.
//
// To use: Firebase console -> Firestore Database -> Rules -> paste this file -> Publish.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /qs_sync/{code} {
      allow get: if true;

      allow create, update: if
        code.matches('QS-[A-Z2-9]{4}-[A-Z2-9]{4}') &&
        request.resource.data.keys().hasOnly(['saved', 'dismissed', 'channels']) &&
        request.resource.data.saved is list && request.resource.data.saved.size() <= 5000 &&
        request.resource.data.dismissed is list && request.resource.data.dismissed.size() <= 5000 &&
        request.resource.data.channels is list && request.resource.data.channels.size() <= 200;

      allow delete: if false;
    }

    match /qs_channels/{name} {
      allow get, list: if true;

      allow create: if
        name.matches('[a-z0-9_]{5,32}') &&
        request.resource.data.channel is string &&
        request.resource.data.channel.lower() == name &&
        request.resource.data.status == 'approved' &&
        request.resource.data.added_by is string && request.resource.data.added_by.size() <= 32 &&
        request.resource.data.added_at is string;

      // No client update/delete: once a channel is linked, nobody (including whoever added
      // it) can rewrite or remove that document from the app. Changing or retiring a
      // channel is a by-hand operation in the Firebase console.
      allow update, delete: if false;
    }
  }
}
